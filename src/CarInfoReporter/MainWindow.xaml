<!-- Language="cs-CZ" makes the bindings format numbers and dates the Czech way (1 000 000,00 and 4.12.2010). -->
<Window x:Class="CarInfoReporter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Car Info Reporter"
        Language="cs-CZ"
        Width="900" Height="600" MinWidth="700" MinHeight="400"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="RightAlignedCell" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="6,0" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>

        <!-- File selection -->
        <StackPanel Grid.Row="0" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,0,0,16">
            <Button Content="Open XML file..." Command="{Binding OpenFileCommand}" Padding="12,6" />
            <TextBlock Text="{Binding FilePath}" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="Gray" />
        </StackPanel>

        <!-- All sold cars from the file -->
        <DockPanel Grid.Row="1" Grid.Column="0">
            <TextBlock DockPanel.Dock="Top" Text="Sold cars" Style="{StaticResource SectionTitle}" />
            <DataGrid ItemsSource="{Binding Sales}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="LightGray">
                <DataGrid.RowStyle>
                    <!-- Weekend sales are highlighted, these are the ones counted in the summary. -->
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsWeekendSale}" Value="True">
                                <Setter Property="Background" Value="#FFF4D6" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Model name" Binding="{Binding ModelName}" Width="*" />
                    <DataGridTextColumn Header="Sale date" Binding="{Binding SaleDate, StringFormat=d}" />
                    <DataGridTextColumn Header="Day" Binding="{Binding SaleDate.DayOfWeek}" />
                    <DataGridTextColumn Header="Price" Binding="{Binding Price, StringFormat=N2}"
                                        ElementStyle="{StaticResource RightAlignedCell}" />
                    <DataGridTextColumn Header="VAT %" Binding="{Binding VatRate}"
                                        ElementStyle="{StaticResource RightAlignedCell}" />
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <!-- Weekend sales summed for each model, in the layout required by the assignment -->
        <DockPanel Grid.Row="1" Grid.Column="2">
            <TextBlock DockPanel.Dock="Top" Text="Weekend sales by model" Style="{StaticResource SectionTitle}" />
            <Border BorderBrush="Gray" BorderThickness="1">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#E0E0E0" Padding="8,6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Model name" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Price without VAT" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="Price with VAT" />
                        </Grid>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding WeekendSummaries}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="LightGray" BorderThickness="0,0,0,1" Padding="8,6">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition />
                                                <RowDefinition />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition />
                                                <ColumnDefinition />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="{Binding ModelName}" FontWeight="SemiBold" />
                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding PriceWithoutVat, StringFormat=N2}" />
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PriceWithVat, StringFormat=N2}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </DockPanel>
    </Grid>
</Window>
