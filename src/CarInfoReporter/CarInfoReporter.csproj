<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <!-- Copy the sample data next to the exe so the "Open" dialog can start there. -->
  <ItemGroup>
    <Content Include="..\..\data\car-sales.xml" Link="data\car-sales.xml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
